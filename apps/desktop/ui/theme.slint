import { CoverFlowTokens as T } from "echo-tokens.slint";
export global EchoTheme {
    in-out property <bool> dark <=> T.dark;
    in-out property <bool> high-contrast;
    in-out property <color> hc-background: #000000;
    in-out property <color> hc-text: #ffffff;
    in-out property <color> hc-highlight: #ffff00;
    in-out property <color> hc-highlight-text: #000000;
    in-out property <color> hc-muted: #ffffff;
    out property <color> text: high-contrast ? hc-text : T.color-text;
    out property <color> muted: high-contrast ? hc-muted : T.color-muted;
    out property <color> canvas: high-contrast ? hc-background : T.color-canvas;
    out property <color> surface: high-contrast ? hc-background : T.color-panel;
    out property <color> elevated: high-contrast ? hc-background : T.color-raised;
    out property <color> line: high-contrast ? hc-text : T.color-line;
    out property <color> amber: high-contrast ? hc-highlight : T.color-accent;
    out property <color> on-accent: high-contrast ? hc-highlight-text : T.color-on-accent;
    out property <color> danger: high-contrast ? hc-text : T.color-danger;
    out property <color> selection: high-contrast ? hc-highlight : T.color-selection;
    out property <color> selected-text: high-contrast ? hc-highlight-text : T.color-text;
}

export component EchoButton inherits Rectangle {
    in property <bool> row-action;
    in property <bool> execution-blocked;
    in property <bool> take-focus-on-click: true;
    in property <string> label;
    in property <string> text;
    in property <image> icon;
    in property <bool> primary;
    in property <bool> flat;
    in property <bool> danger;
    in property <bool> enabled: true;
    in property <bool> checked;
    callback clicked();
    out property <bool> focused: focus.has-focus;
    callback focus-changed(bool);
    changed focused => {root.focus-changed(self.focused);}
    forward-focus: focus;
    min-width: row-action ? T.row-action-size : text == "" ? 32px : content.min-width + 24px;
    height: row-action ? T.row-action-size : T.control-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: row-action ? T.row-action-radius : T.control-radius;
    background: row-action ? (touch.has-hover ? (EchoTheme.high-contrast ? EchoTheme.selection : T.row-action-hover) : transparent) : primary ? EchoTheme.amber : checked || touch.has-hover ? EchoTheme.surface : flat ? transparent : EchoTheme.elevated;
    border-width: focus.has-focus || !flat ? 1px : 0px;
    border-color: focus.has-focus ? EchoTheme.amber : EchoTheme.line;
    opacity: enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: label == "" ? text : label;
    accessible-enabled: enabled && !execution-blocked;
    accessible-action-default => { if (enabled && !execution-blocked) { root.clicked(); } }
    content := HorizontalLayout {
        padding: root.row-action ? 4px : 6px;
        spacing: 6px;
        alignment: center;
        if (root.icon.width > 0): Image {
            source: root.icon;
            width: root.row-action ? T.row-action-icon-size : 18px;
            height: root.row-action ? T.row-action-icon-size : 18px;
            colorize: root.row-action ? (EchoTheme.high-contrast ? (touch.has-hover ? EchoTheme.on-accent : EchoTheme.text) : root.danger ? EchoTheme.danger : T.row-action-color) : root.primary ? EchoTheme.on-accent : root.danger ? EchoTheme.danger : EchoTheme.muted;
        }
        if (root.text != ""): Text {
            text: root.text;
            color: root.primary ? EchoTheme.on-accent : root.danger ? EchoTheme.danger : EchoTheme.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
            accessible-role: none;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { if (!root.execution-blocked) { if (root.take-focus-on-click) { focus.focus(); } root.clicked(); } }
    }
    private property <bool> hint-requested: root.row-action && root.enabled && (touch.has-hover || focus.has-focus);
    private property <bool> hint-visible: false;
    changed hint-requested => {root.hint-visible = false;}
    Timer {
        interval: 450ms;
        running: root.hint-requested && !root.hint-visible;
        triggered => {root.hint-visible = root.hint-requested;}
    }
    // Draw in the existing scene, without a native tooltip window or input area.
    if (root.hint-visible && root.label != ""): Rectangle {
        x: root.width - self.width; y: root.height + 6px;
        width: hint-label.preferred-width + 24px; height: 38px;
        border-radius: 14px;
        background: EchoTheme.elevated;
        border-width: 1px; border-color: EchoTheme.line;
        drop-shadow-blur: 8px; drop-shadow-offset-y: 2px;
        drop-shadow-color: EchoTheme.high-contrast ? transparent : #00000012;
        hint-label := Text {
            text: root.label; color: EchoTheme.text; font-size: 13px;
            horizontal-alignment: center; vertical-alignment: center;
            accessible-role: none;
        }
    }
    focus := FocusScope {
        width: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { if (!root.execution-blocked) { root.clicked(); } return accept; }
            return reject;
        }
    }
}

export component Hint inherits Rectangle {
    in property <string> text;
    background: EchoTheme.surface;
    border-radius: 4px;
    border-width: 1px;
    border-color: EchoTheme.line;
    min-width: label.preferred-width + 12px;
    height: 27px;
    horizontal-stretch: 0;
    label := Text { text: root.text; color: EchoTheme.muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
}
