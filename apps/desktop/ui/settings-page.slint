import { LineEdit } from "echo-lineedit.slint";
import { I18n } from "i18n.slint";
import { ScrollView } from "std-widgets.slint";
import { EchoSelect } from "echo-select.slint";
import { EchoSwitch } from "echo-switch.slint";
import { EchoTheme, EchoButton } from "theme.slint";
import { DesignTokens as T } from "echo-tokens.slint";
import { SpaceVm } from "space-models.slint";
import { EnumChoice } from "enum-choice.slint";
import { ShortcutRow } from "shortcut-row.slint";
import { SpaceChoice } from "space-choice.slint";

component SettingsNavButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    border-radius: 8px;
    background: root.checked ? EchoTheme.selection : (touch.has-hover ? EchoTheme.surface : transparent);
    opacity: root.enabled ? 1 : 0.45;
    forward-focus: focus;
    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; }
            return reject;
        }
    }
    content := HorizontalLayout {
        x: 10px; y: (parent.height - self.height) / 2;
        width: parent.width - 20px; height: 16px; spacing: 8px; alignment: start;
        Image { source: root.icon; width: 16px; height: 16px; image-fit: contain; colorize: EchoTheme.text; }
        Text { text: root.text; width: self.preferred-width; height: parent.height; color: EchoTheme.text; font-size: 15px; font-weight: root.checked ? T.font-weight-medium : T.font-weight-normal; vertical-alignment: center; horizontal-alignment: left; accessible-role: none; }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

export component SettingsPage inherits Rectangle {
    callback hide();
    in-out property <string> theme-mode;
    in-out property <string> language;
    in-out property <bool> global-hotkey-enabled;
    in-out property <string> global-hotkey;
    in property <string> hotkey-status;
    in property <bool> hotkey-registration-failed;
    in-out property <string> startup-space;
    in property <[string]> startup-space-names;
    in property <int> startup-space-index;
    in-out property <string> query-on-switch;
    in-out property <string> side-content;
    in-out property <string> graphics-mode;
    in-out property <string> frame-rate;
    in-out property <bool> loop-spaces;
    in-out property <bool> remember-position;
    in-out property <bool> input-method-indicator;
    in-out property <bool> reflections;
    in-out property <bool> trim-when-hidden;
    in-out property <bool> reduce-on-battery;
    in property <[SpaceVm]> spaces;
    in property <bool> busy;
    in property <bool> dirty;
    in property <bool> valid: true;
    in property <bool> restart-required;
    in property <string> error;
    in property <string> notice;
    callback edited();
    changed language => { root.edited(); }
    changed theme-mode => { root.edited(); }
    changed global-hotkey-enabled => { root.edited(); }
    changed global-hotkey => { root.edited(); }
    changed startup-space => { root.edited(); }
    changed query-on-switch => { root.edited(); }
    changed side-content => { root.edited(); }
    changed graphics-mode => { root.edited(); }
    changed frame-rate => { root.edited(); }
    changed loop-spaces => { root.edited(); }
    changed remember-position => { root.edited(); }
    changed input-method-indicator => { root.edited(); }
    changed reflections => { root.edited(); }
    changed trim-when-hidden => { root.edited(); }
    changed reduce-on-battery => { root.edited(); }

    callback save();
    callback cancel();
    callback action(string);
    callback space-action(string,string);
    out property <length> scroll-center-x: settings-scroll.x + settings-scroll.width / 2;
    out property <length> scroll-center-y: settings-scroll.y + settings-scroll.height / 2;
    callback scroll-anchor-changed(length,length);
    init => { root.scroll-anchor-changed(root.scroll-center-x,root.scroll-center-y); }
    changed scroll-center-x => { root.scroll-anchor-changed(root.scroll-center-x,root.scroll-center-y); }
    changed scroll-center-y => { root.scroll-anchor-changed(root.scroll-center-x,root.scroll-center-y); }
    private property <int> section;
    changed section => {settings-scroll.viewport-y=0px;}
    private property <bool> narrow: root.width < 850px;
    private property <[string]> categories: [@tr("Appearance"), @tr("Spaces"), @tr("Quick Input")];
    background: transparent;
    Image { x: 28px; y: settings-title.y + (settings-title.height - self.height) / 2; width: 26px; height: 26px; source: @image-url("favorite-icons/SettingsCog.svg"); colorize: EchoTheme.text; image-fit: contain; }
    settings-title := Text { x: 64px; y: 15px; text: @tr("Settings"); color: EchoTheme.text; font-size: T.font-setting-title; font-weight: 600; }
    EchoButton {
        x: parent.width - 60px; y: 15px; width: 32px; height: 32px;
        row-action: true; flat: true; icon: @image-url("icons/close.svg");
        label: @tr("Hide to tray"); enabled: !root.busy;
        clicked => { root.hide(); }
    }
    if (root.narrow): EchoSelect { enabled: !root.busy;
        x: 28px; y: 62px; width: parent.width - 56px; height: 36px;
        model: root.categories; selected-index: root.section; selection-changed(index) => { root.section = index; } accessible-label: @tr("Settings category");
    }
    if (!root.narrow): VerticalLayout {
        x: 64px; y: 75px; width: 184px; spacing: 4px;
        for label[index] in root.categories: SettingsNavButton {
            icon: index == 0 ? @image-url("favorite-icons/ColorTheme.svg") : index == 1 ? @image-url("favorite-icons/BuildingWorkspace.svg") : @image-url("favorite-icons/KeyboardShortcut.svg");
            text: label; checked: root.section == index;
            width: parent.width; height: 36px;
            clicked => { root.section = index; }
        }
    }
    settings-scroll := ScrollView {
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;
        x: root.narrow ? 28px : T.settings-nav-width + 46px;
        y: root.narrow ? 113px : 73px;
        width: min(T.settings-max-form-width,parent.width - self.x - 28px);
        height: max(80px,parent.height - self.y - 95px);
        VerticalLayout {
            padding: 2px; spacing: 16px; alignment: start;
            Rectangle {
                height: max(section-title.preferred-height, root.section == 1 ? 32px : 0px);
                section-title := Text {
                    x: 0px;
                    width: max(0px, parent.width - (root.section == 1 ? 40px : 0px));
                    height: parent.height; vertical-alignment: center;
                    text: root.categories[root.section]; color: EchoTheme.text;
                    font-size: 20px; font-weight: 600;
                }
                if (root.section == 1): EchoButton {
                    x: parent.width - self.width; y: (parent.height - self.height) / 2;
                    width: 32px; height: 32px; row-action: true; flat: true;
                    icon: @image-url("icons/plus.svg"); label: @tr("New space");
                    enabled: !root.busy; clicked => { root.space-action("new", ""); }
                }
            }
            if (root.section == 0): VerticalLayout {
                spacing: 12px; alignment: start;
                Text { text: @tr("Theme"); color: EchoTheme.text; }
                EnumChoice { enabled: !root.busy; model: [@tr("Light"), @tr("Dark")]; selected-index: root.theme-mode == "dark" ? 1 : 0; selected(value) => { root.theme-mode = self.current-index == 1 ? "dark" : "light"; } accessible-label: @tr("Theme"); }
                Text { text: @tr("Language"); color: EchoTheme.text; }
                EnumChoice { enabled: !root.busy; model: ["简体中文", "English"]; selected-index: root.language == "en" ? 1 : 0; selected(value) => { root.language = self.current-index == 1 ? "en" : "zh-CN"; } accessible-label: @tr("Language"); }
            }
            if (root.section == 1): VerticalLayout {
                spacing: 12px; alignment: start;
                for space in root.spaces: Rectangle {
                    accessible-role:groupbox;accessible-label:@tr("Space ") + space.title;
                    height: 64px;
                    Rectangle { x: 0px; y: 16px; width: 3px; height: 24px; background: EchoTheme.amber; border-radius: 2px; }
                    Text { x: 14px; y: 7px; width: parent.width - (space.system ? 100px : 184px); height: 24px; text: space.title; color: EchoTheme.text; font-size: 15px; overflow: elide; }
                    Text { x: 14px; y: 33px; width: parent.width - 184px; text: space.count + @tr(" items"); color: EchoTheme.muted; font-size: 12px; overflow: elide; }
                    if (space.system): Text { x: parent.width - 76px; y: 20px; width: 72px; text: @tr("System"); color: EchoTheme.muted; font-size: 12px; }
                    if (!space.system): HorizontalLayout {
                        x: parent.width - 178px; y: 12px; width: 178px; height: 36px; spacing: 3px; alignment: end;
                        EchoButton { icon: @image-url("icons/up.svg"); label: @tr("Move space up"); flat: true; enabled: !root.busy; clicked => { root.space-action("up",space.key); } }
                        EchoButton { icon: @image-url("icons/down.svg"); label: @tr("Move space down"); flat: true; enabled: !root.busy; clicked => { root.space-action("down",space.key); } }
                        EchoButton { icon: @image-url("icons/edit.svg"); label: @tr("Edit space"); flat: true; enabled: !root.busy; clicked => { root.space-action("edit",space.key); } }
                        EchoButton { icon: @image-url("icons/delete.svg"); label: @tr("Delete space"); flat: true; danger: true; enabled: !root.busy; clicked => { root.space-action("delete",space.key); } }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: EchoTheme.line; }
                }
                EchoSwitch { enabled: !root.busy; text: @tr("Cycle from the last space back to the first"); checked <=> root.loop-spaces; }
                EchoSwitch { enabled: !root.busy; text: @tr("Remember selection and scroll position in this session"); checked <=> root.remember-position; }
                Text { text: @tr("Home screen"); color: EchoTheme.text; }
                SpaceChoice {
                    enabled: !root.busy; model: root.startup-space-names;
                    spaces: root.spaces;
                    selected-index: root.startup-space-index;
                    selected(index) => {
                        root.startup-space = index == root.spaces.length ? "last" : root.spaces[index].key;
                    }
                    accessible-label: @tr("Home screen");
                }
            }
            if (root.section == 2): VerticalLayout {
                spacing: 16px; alignment: start;
                EchoSwitch { enabled: !root.busy; text: @tr("Input method indicator"); checked <=> root.input-method-indicator; }
                HorizontalLayout { spacing: 8px;
                    Text { text: @tr("Global quick insert shortcut"); color: EchoTheme.text; font-size: 14px; min-width: 0px; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                    LineEdit { width: max(72px,min(180px,settings-scroll.width * 0.32)); horizontal-stretch: 0; text <=> root.global-hotkey; accessible-label: @tr("Global quick insert shortcut"); enabled: !root.busy && root.global-hotkey-enabled; }
                    EchoButton { icon: @image-url("icons/apps-sdk/ArrowRotateCcw.svg"); label: @tr("Reset"); row-action: true; flat: true; tooltip-enabled: true; width: 36px; height: 36px; enabled: !root.busy; clicked => { root.global-hotkey = "Alt+V"; root.global-hotkey-enabled = true; } }
                    EchoSwitch { width: 40px; horizontal-stretch: 0; label: @tr("Enable global quick insert shortcut"); checked <=> root.global-hotkey-enabled; enabled: !root.busy; }
                }
                if (root.hotkey-registration-failed): HorizontalLayout { spacing: 8px; alignment: start;
                    EchoButton { text: @tr("Retry saved shortcut"); enabled: !root.busy && !root.dirty; clicked => { root.action("retry-hotkey"); } }
                }
                VerticalLayout {
                    spacing: 6px; padding-top: 10px; alignment: start;
                    Text { text: @tr("Navigation"); color: EchoTheme.muted; font-size: 13px; font-weight: 600; }
                    ShortcutRow { title: @tr("Next space"); keys: ["Tab"]; key-label: "Tab"; }
                    ShortcutRow { title: @tr("Previous space"); keys: ["Shift", "Tab"]; key-label: "Shift+Tab"; }
                    ShortcutRow { title: @tr("Select content"); keys: ["↑", "↓"]; key-label: @tr("Up or Down arrow"); }
                    ShortcutRow { title: @tr("Switch focus mode"); keys: ["F6"]; key-label: "F6"; }
                }
                VerticalLayout {
                    spacing: 6px; alignment: start;
                    Text { text: @tr("Actions"); color: EchoTheme.muted; font-size: 13px; font-weight: 600; }
                    ShortcutRow { title: @tr("Insert selected content"); keys: ["Enter"]; key-label: "Enter"; }
                    ShortcutRow { title: @tr("New content"); keys: ["Ctrl", "N"]; key-label: "Ctrl+N"; }
                    ShortcutRow { title: @tr("New space"); keys: ["Ctrl", "Shift", "N"]; key-label: "Ctrl+Shift+N"; }
                    ShortcutRow { title: @tr("Go back or hide Echo"); keys: ["Esc"]; key-label: "Esc"; }
                }
            }
            if (root.notice != ""): Text { text: I18n.message(root.notice); color: EchoTheme.muted; wrap: word-wrap; min-width: 0px; }
            if (root.error != ""): Text { text: I18n.error(root.error); color: EchoTheme.danger; wrap: word-wrap; min-width: 0px; }
            if (root.narrow): HorizontalLayout {
                alignment: start; spacing: 10px;
                EchoButton { text: @tr("Quit"); font-size: 15px; clicked => { root.action("quit"); } }
            }
        }
    }
    Rectangle {
        y: parent.height - 78px; height: 78px; background: transparent;
        Text { x: 28px; y: 23px; width: max(0px,parent.width - 340px); text: root.error != "" ? I18n.error(root.error) : root.notice != "" && root.notice != "Settings saved" ? I18n.message(root.notice) : root.restart-required ? @tr("Restart required for graphics changes") : ""; color: root.error != "" ? EchoTheme.danger : EchoTheme.muted; overflow: elide; }
        HorizontalLayout {
            x: parent.width - 298px; y: 18px; width: 270px; height: 36px; spacing: 10px; alignment: end;
            EchoButton { text: @tr("Cancel"); enabled: !root.busy; clicked => { root.cancel(); } }
            EchoButton { text: root.busy ? @tr("Saving…") : @tr("Save"); primary: true; enabled: root.dirty && root.valid && !root.busy; clicked => { root.save(); } }
        }
    }
}
