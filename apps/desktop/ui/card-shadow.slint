import { EchoTheme } from "theme.slint";

// A compact menu-like shadow; the card supplies its own hairline border.
// Keep the existing 16px horizontal / 12px top envelope so layout and native
// hit regions stay unchanged. No blur surface or cached card pixels.
export component CardShadow inherits Rectangle {
    in property <length> radius: 20px;
    accessible-role: none;
    for index in 8: Rectangle {
        x: 8px + index * 1px; y: 6px + index * 1px;
        width: max(0px, parent.width - 16px - 2 * index * 1px);
        height: max(0px, parent.height - 16px - 2 * index * 1px);
        border-radius: root.radius + 8px - index * 1px;
        background: EchoTheme.high-contrast ? transparent : #000000.with-alpha(EchoTheme.dark ? 0.022 : 0.012);
        accessible-role: none;
    }
}
