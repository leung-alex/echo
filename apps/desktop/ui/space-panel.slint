import { ListView } from "std-widgets.slint";
import { EchoTheme, EchoButton } from "theme.slint";
import { CoverFlowTokens as T } from "echo-tokens.slint";
import { EntryRow, EntryView } from "entry-row.slint";
import { FavoriteIconImages } from "favorite-icon-images.slint";
export component SpacePanel inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> icon-key;
    in property <color> accent: EchoTheme.amber;
    in property <[EntryRow]> rows;
    in property <bool> favorites;
    in property <bool> capture-only;
    in property <float> shadow-opacity: 1;
    in property <bool> titles-only;
    in property <bool> loading;
    in property <bool> stale;
    in property <bool> error;
    in property <bool> busy;
    in property <bool> compact;
    in property <bool> control-focus-mode;
    in property <bool> batch;
    in property <bool> modal;
    in property <bool> animating;
    in property <int> selected-count;
    in property <int> selection-index;
    in property <bool> quick-insert;
    in property <bool> inline-mode;
    in property <string> empty-state-text;
    private property <length> header-height: T.panel-header-height;
    out property <length> natural-height: root.header-height + 24px + (root.rows.length == 0 ? 78px : list.viewport-height);
    changed natural-height => { if (root.inline-mode && !root.capture-only) {root.viewport-changed();} }
    in property <bool> copy-only;
    in-out property <string> query;
    in property <bool> has-more;
    in property <bool> has-previous;
    in-out property <length> scroll-y;
    in property <string> navigation-label;
    in property <string> navigation-hint: "Tab / Shift+Tab";
    in property <string> status;
    in property <bool> status-error;
    in property <bool> previous-enabled;
    in property <bool> next-enabled;
    callback select(string);
    callback action(string,string);
    callback batch-action(string);
    callback thumbnail-needed(string);
    callback key-event(string,bool,bool,string) -> bool;
    callback create-item();
    callback more();
    callback previous();
    callback menu();
    callback add-existing();
    callback viewport-changed();
    callback query-edited(string);
    callback ime-composing() -> bool;
    callback navigate(int);
    callback choose-space();
    callback new-space();
    callback settings();
    callback hide();
    callback drag();
    pure callback drag-data(string) -> data-transfer;
    callback can-drop-data(data-transfer) -> bool;
    callback drop-data(data-transfer,string) -> bool;
    function handle-content-key(key: string, ctrl: bool, shift: bool, target: string) -> bool {
        if (!root.capture-only && !root.busy && !root.loading && !root.stale && !root.modal && !root.animating && !root.ime-composing()) {
            if (key == Key.PageDown && root.has-more) {root.more();return true;}
            if (key == Key.PageUp && root.has-previous) {root.previous();return true;}
        }
        return root.key-event(key,ctrl,shift,target);
    }
    public function focus-content() {if (!root.inline-mode) {content-focus.focus();}}
    public function focus-controls() {if (root.favorites && new-content.enabled) {new-content.focus();} else if (settings-button.enabled) {settings-button.focus();} else {content-focus.focus();}}
    public function reset-scroll() {list.viewport-y = 0px;}
    public function reveal-selection() {list.viewport-y = -max(0px,(selection-index - 1)*list.viewport-height/max(1,rows.length));}
    changed scroll-y => {if (!root.capture-only) {root.viewport-changed();}}
    forward-focus: content-focus;
    content-focus := FocusScope {
        width: 0px; enabled: !root.capture-only;
        key-pressed(event) => {return root.handle-content-key(event.text,event.modifiers.control,event.modifiers.shift,"surface") ? accept : reject;}
    }
    background: EchoTheme.surface; border-radius: T.panel-radius;
    border-width: T.line-width; border-color: EchoTheme.line; clip: true;
    drop-shadow-blur: root.capture-only ? 0px : T.flow-shadow-softness;
    drop-shadow-offset-y: root.capture-only ? 0px : T.flow-shadow-offset-y;
    drop-shadow-color: #000000.with-alpha(T.flow-shadow-opacity * root.shadow-opacity);
    accessible-role: groupbox; accessible-enabled: !root.capture-only && !root.animating;
    accessible-label: root.capture-only ? "" : root.title + " space";
    TouchArea {height:58px;enabled:!root.inline-mode && !root.capture-only && !root.busy;
        pointer-event(event) => {if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {root.drag();}}
    }
    Rectangle {x:T.panel-padding;y:20px;width:4px;height:30px;background:root.accent;border-radius:2px;}
    if (FavoriteIconImages.image-for(root.icon-key).width > 0): Image {
        x:T.panel-padding + 13px;y:24px;width:24px;height:24px;
        source:FavoriteIconImages.image-for(root.icon-key);colorize:EchoTheme.text;
    }
    Text {
        x:T.panel-padding + (root.icon-key == "" ? 14px : 48px);y:18px;
        width:max(30px,parent.width - self.x - T.panel-padding - (root.favorites ? 84px : 140px));height:30px;text:root.title;
        color:EchoTheme.text;font-size:T.font-panel-title;font-weight:T.font-weight-semibold;overflow:elide;
    }
    new-content := EchoButton {
        x: root.width - T.panel-padding - 72px; y: 18px;
        width: 32px; height: 32px; row-action: true;
        icon: @image-url("favorite-icons/ComposeEditSquare.svg"); label: "New content";
        visible: root.favorites && !root.capture-only && !root.titles-only;
        enabled: root.favorites && !root.capture-only && !root.titles-only && !root.busy && !root.loading && !root.stale && !root.error && !root.modal && !root.animating;
        take-focus-on-click: !root.inline-mode;
        clicked => { if (!root.ime-composing()) {root.create-item();} }
    }
    settings-button := EchoButton {
        x: root.width - T.panel-padding - 32px; y: 18px;
        width: 32px; height: 32px; row-action: true;
        icon: @image-url("favorite-icons/SettingsCog.svg"); label: "Settings";
        visible: !root.capture-only && !root.titles-only;
        enabled: !root.capture-only && !root.titles-only && !root.busy && !root.modal && !root.animating;
        take-focus-on-click: !root.inline-mode;
        clicked => { if (!root.ime-composing()) {root.settings();} }
    }
    if (!root.favorites && !root.capture-only && !root.titles-only): EchoButton {
        x: root.width - T.panel-padding - 132px; y: 18px;
        width: 92px; height: 32px; text: "Clear all"; label: "Clear unpinned history";
        enabled: !root.busy && !root.loading && !root.stale && !root.modal && !root.animating;
        take-focus-on-click: !root.inline-mode;
        clicked => { if (!root.ime-composing()) {root.action("clear-all", "");} }
    }
    if (root.batch): HorizontalLayout {
        x:T.panel-padding;y:root.header-height + 8px;width:parent.width - 2*T.panel-padding;height:36px;spacing:8px;alignment:start;
        EchoButton {text:"All loaded";enabled:!root.busy;clicked => {root.batch-action("all");}}
        EchoButton {text:"Move to Favorites";enabled:root.selected-count > 0 && !root.busy;clicked => {root.batch-action("favorite");}}
        EchoButton {text:"Pin";enabled:root.selected-count > 0 && !root.busy;clicked => {root.batch-action("pin");}}
        EchoButton {text:"Delete";danger:true;enabled:root.selected-count > 0 && !root.busy;clicked => {root.batch-action("delete");}}
    }
    list := ListView {
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;
        x:T.panel-padding;y:root.header-height + (root.batch ? 52px : 8px);
        width:parent.width - 2*T.panel-padding;
        height:max(0px,parent.height - self.y - 16px);
        viewport-y <=> root.scroll-y;visible:!root.stale && !root.titles-only;
        for entry in root.rows: EntryView {
            inline-mode: root.inline-mode;
            control-focus-mode:root.control-focus-mode;
            entry:entry;favorites:root.favorites;compact:root.compact;capture-only:root.capture-only;batch:root.batch;
            busy:root.busy;input-blocked:root.loading || root.stale;quick-insert:root.quick-insert;copy-only:root.copy-only;reorder-enabled:root.query == "";
            selected-geometry(y,height) => {
                if (!root.capture-only && !root.animating) {
                    if (y + list.viewport-y < 0px || height > list.visible-height) {list.viewport-y = -y;}
                    else if (y + height + list.viewport-y > list.visible-height) {list.viewport-y = list.visible-height - y - height;}
                }
            }
            select(key) => {root.select(key);}
            action(action,key) => {root.action(action,key);}
            thumbnail-needed(key) => {if (!root.capture-only && !root.animating) {root.thumbnail-needed(key);}}
            key-event(key,ctrl,shift,target) => {return !root.capture-only && root.handle-content-key(key,ctrl,shift,target);}
            drag-data(key) => {return root.drag-data(key);}
            can-drop-data(data) => {return !root.capture-only && root.can-drop-data(data);}
            drop-data(data,key) => {return !root.capture-only && root.drop-data(data,key);}
        }
    }
    if (root.rows.length == 0 || root.stale || root.titles-only): VerticalLayout {
        x:T.panel-padding;y:root.inline-mode ? root.header-height + 16px : max(root.header-height + 24px,(parent.height - 240px)/2);
        width:parent.width - 2*T.panel-padding;height:root.inline-mode ? 70px : 240px;alignment:start;spacing:16px;
        if (root.favorites && !root.inline-mode && !root.loading && !root.error && !root.stale && !root.titles-only && root.query == ""): Rectangle {
            height:100px;
            Image {x:(parent.width - 104px)/2;width:104px;height:100px;source:@image-url("icons/favorites-empty.svg");}
        }
        if (!root.favorites || root.titles-only || root.loading || root.error || root.stale || root.query != ""): Text {text:root.titles-only ? "Private space" : root.empty-state-text != "" ? root.empty-state-text : root.loading ? "Loading…" : root.error ? "Unable to load this space" : root.query != "" ? "No matches in this space" : root.favorites ? "" : "Your clipboard history appears here";
            color:EchoTheme.text;font-size:root.inline-mode ? 15px : 19px;horizontal-alignment:center;wrap:word-wrap;}
        if (!root.capture-only && root.error): EchoButton {text:"Retry";clicked => {root.action("retry","");}}
    }
}
