import { SpacePanel } from "space-panel.slint";
import { SpaceSideCard, CarouselCard } from "software-cards.slint";
import { EchoTheme } from "theme.slint";

export component SlidePreview inherits Rectangle {
    in property <float> progress: 1;
    height: 232px;
    clip: true;
    property <length> card-width: max(200px,(root.width - 12px) / 1.7);
    property <length> side-width: root.card-width * 0.7;
    CarouselCard {
        x: (root.card-width + 12px) * (1 - root.progress); y: 16px * (1 - root.progress);
        width: root.side-width + (root.card-width - root.side-width) * root.progress;
        height: root.height - 32px * (1 - root.progress);
        content-width: root.card-width; content-height: root.height;
        content-opacity: max(0,min(1,root.progress * 3 - 2));
        space: {key:"favorites",title:"Favorites",icon-key:"Star",count:"200",accent:EchoTheme.amber,system:true,selected:false};
        SpacePanel {
            width: root.card-width; height: root.height;
            title: "Favorites"; subtitle: "Synthetic example content"; icon-key: "Star";
            empty-state-text: "Reusable content"; capture-only: true;
        }
    }
    if (root.progress < 1): CarouselCard {
        x: -(root.side-width + 12px) * root.progress; y: 16px * root.progress;
        width: root.card-width - (root.card-width - root.side-width) * root.progress;
        height: root.height - 32px * root.progress;
        content-width: root.card-width; content-height: root.height;
        content-opacity: max(0,1 - root.progress * 3);
        space: {key:"history",title:"History",icon-key:"History",count:"2000",accent:EchoTheme.amber,system:true,selected:false};
        SpacePanel {
            width: root.card-width; height: root.height;
            title: "History"; subtitle: "Synthetic example content"; icon-key: "History";
            empty-state-text: "Clipboard timeline"; capture-only: true;
        }
    }
    SpaceSideCard {
        x: root.card-width + 12px + (root.side-width + 12px) * (1 - root.progress); y: 16px;
        width: root.side-width; height: parent.height - 32px; enabled: false; opacity: root.progress;
        space: { key: "preview", title: "Work", icon-key: "Folder", count: "12", accent: EchoTheme.amber, system: false, selected: false };
    }
}
