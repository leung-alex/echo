import { ListView, LineEdit } from "std-widgets.slint";
import { EchoTheme, EchoButton } from "theme.slint";
import { FavoriteIconImages } from "favorite-icon-images.slint";
export struct FavoriteIconChoice { key: string, label: string }
export component FavoriteIconPicker inherits Rectangle {
    in property <[FavoriteIconChoice]> choices;
    in property <string> selected-key;
    callback filter(string);
    callback chosen(string);
    callback dismissed();
    private property <int> active-index;
    public function choose-active() {
        if (root.active-index >= 0 && root.active-index < root.choices.length) {
            root.chosen(root.choices[root.active-index].key);
        }
    }
    background: #00000080;
    TouchArea { }
    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Tab) { if (search.has-focus) { close.focus(); } else { search.focus(); } return accept; }
            if (event.text == Key.DownArrow) { root.active-index = min(root.choices.length - 1, root.active-index + 1); icon-list.viewport-y = -max(0px,(root.active-index - 5) * 40px); return accept; }
            if (event.text == Key.UpArrow) { root.active-index = max(0,root.active-index - 1); icon-list.viewport-y = -max(0px,(root.active-index - 5) * 40px); return accept; }
            if (event.text == Key.Escape) { root.dismissed(); return accept; }
            return reject;
        }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(460px,parent.width - 24px); height: min(560px,parent.height - 24px);
            background: EchoTheme.elevated; border-color: EchoTheme.line; border-width: 1px; border-radius: 14px;
            accessible-role: groupbox; accessible-label: "Choose favorite icon";
            init => { search.focus(); }
            VerticalLayout {
                padding: 18px; spacing: 12px;
                Text { text: "Choose an icon"; color: EchoTheme.text; font-size: 20px; font-weight: 650; }
                search := LineEdit {
                    placeholder-text: "Search the original icon catalog";
                    accessible-label: "Search favorite icons";
                    edited => { root.active-index = 0; root.filter(self.text); }
                    accepted => { root.choose-active(); }
                    accessible-action-set-value(value) => { self.text = value; root.active-index = 0; root.filter(value); }
                }
                Text { text: search.text == "" ? "Common icons · search all 745 choices" : "Up to 48 matching icons"; color: EchoTheme.muted; font-size: 11px; wrap: word-wrap; }
                icon-list := ListView {
                    for choice[index] in root.choices: EchoButton {
                        height: 40px; min-width: 0px;
                        icon: FavoriteIconImages.image-for(choice.key);
                        text: choice.label;
                        label: choice.key == "none" ? "No icon" : "Icon " + choice.key;
                        checked: index == root.active-index || choice.key == root.selected-key || (choice.key == "none" && root.selected-key == "");
                        clicked => { root.chosen(choice.key); }
                    }
                }
                if (root.choices.length == 0): Text { text: "No matching icons"; color: EchoTheme.muted; }
                close := EchoButton { text: "Close"; label: "Close icon picker"; clicked => { root.dismissed(); } }
            }
        }
    }
}
