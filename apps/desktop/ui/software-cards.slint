import { DesignTokens as T } from "echo-tokens.slint";
import { I18n } from "i18n.slint";
import { EchoTheme } from "theme.slint";
import { FavoriteIconImages } from "favorite-icon-images.slint";
import { EntryRow } from "entry-row.slint";
import { SpaceVm } from "space-models.slint";
import { CardShadow } from "card-shadow.slint";

export struct SidePreviewRow { title: string, body: string, image: image }
export struct SidePreview { rows: [SidePreviewRow], loading: bool, message: string }

// UI-thread model references, never a bitmap or another data/clipboard owner.
export struct OutgoingPanel {
    rows: [EntryRow], title: string, subtitle: string, icon-key: string, accent: color,
    favorites: bool, clearable: bool, scroll-y: length, query: string,
    navigation-label: string, navigation-hint: string,
    previous-enabled: bool, next-enabled: bool, has-more: bool, has-previous: bool,
    batch: bool, selected-count: int, selection-index: int,
    status: string, status-error: bool, empty-state-text: string,
}

export component SpaceSideCard inherits Rectangle {
    in property <SpaceVm> space;
    in property <SidePreview> preview;
    in property <bool> enabled: true;
    in property <length> layout-width: root.width;
    in property <length> layout-height: root.height;
    callback chosen();
    width: 448px;
    background: area.has-hover && root.enabled ? EchoTheme.elevated : EchoTheme.surface;
    border-radius: 20px; border-width: 1px; border-color: EchoTheme.line;
    accessible-role: button;
    accessible-label: @tr("Switch to ") + root.space.title + " · " + root.space.count + @tr(" items");
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.chosen(); } }
    // The frame may resize, but side labels and previews keep their settled layout.
    Rectangle {
        width: root.width; height: root.height; clip: true;
        Rectangle {
            x: 0px; y: 0px;
            width: root.layout-width; height: root.layout-height;
    Image {
        x: 20px; y: 22px;
        width: 24px; height: 24px;
        source: FavoriteIconImages.image-for(root.space.icon-key); colorize: EchoTheme.text;
        accessible-role: none;
    }
    Text {
        x: 54px; y: 16px; width: parent.width - 74px; height: 44px;
        text: root.space.title; color: EchoTheme.text; font-size: T.font-body; font-weight: T.font-weight-semibold;
        wrap: word-wrap; overflow: elide; vertical-alignment: center;
        accessible-role: none;
    }
    Text {
        x: 20px; y: 62px; width: parent.width - 40px; height: 24px;
        text: root.space.count + @tr(" items"); color: EchoTheme.muted; font-size: T.font-secondary;
        overflow: elide; accessible-role: none;
    }
    Rectangle {
        x: 16px; y: 96px; width: parent.width - 32px; height: max(0px,parent.height - 116px); clip: true;
        VerticalLayout {
            width: parent.width; alignment: start; spacing: 10px;
            for row in root.preview.rows: Rectangle {
                height: row.image.width > 0 ? 142px : 108px;
                background: EchoTheme.elevated; border-radius: T.row-radius; border-width: 1px; border-color: EchoTheme.line;
                accessible-role: text; accessible-label: row.title + " " + row.body;
                Text { x: 12px; y: 10px; width: parent.width - 24px; height: row.title == "" ? 0px : 20px;
                    text: row.title; color: EchoTheme.row-text; font-size: T.font-secondary; overflow: elide; }
                if (row.image.width > 0): Image {
                    x: 12px; y: row.title == "" ? 12px : 36px; width: parent.width - 24px; height: row.title == "" ? 118px : 94px;
                    source: row.image; image-fit: contain; accessible-role: none;
                }
                if (row.image.width == 0): Text {
                    x: 12px; y: row.title == "" ? 12px : 36px; width: parent.width - 24px; height: row.title == "" ? 80px : 60px;
                    text: row.body; color: EchoTheme.row-text; font-size: T.font-body; wrap: word-wrap; overflow: elide;
                }
            }
            if (root.preview.loading || root.preview.rows.length == 0): Text {
                text: root.preview.loading ? @tr("Filtering…") : I18n.message(root.preview.message);
                color: EchoTheme.muted; font-size: 13px; wrap: word-wrap; min-height: 40px;
            }
        }
    }
        }
    }
    area := TouchArea { enabled: root.enabled; clicked => { root.chosen(); } }
}

// The frame changes size; its complete content remains at final native layout
// size. Clipping/revealing it never rescales text or creates a card bitmap.
export component CarouselCard inherits Rectangle {
    in property <length> content-width;
    in property <length> content-height;
    in property <length> side-content-width;
    in property <float> content-opacity: 1;
    in property <SpaceVm> space;
    in property <SidePreview> preview;
    in property <bool> software: true;
    private property <length> inset: root.content-opacity < 1 ? 16px : 0px;
    if (root.software): CardShadow {
        x: -16px; y: -12px; width: root.width + 32px; height: root.height + 32px;
    }
    Rectangle {
        width: root.width; height: root.height;
        background: root.software ? EchoTheme.surface : transparent;
        border-radius: 20px;
        Rectangle {
            x: root.inset; y: root.inset;
            width: parent.width - 2 * root.inset; height: parent.height - 2 * root.inset;
            clip: true; opacity: root.content-opacity;
            Rectangle {
                x: -root.inset; y: -root.inset;
                width: root.content-width; height: root.content-height;
                @children
            }
        }
        if (root.content-opacity < 1): SpaceSideCard {
            width: parent.width; height: parent.height; space: root.space;
            layout-width: root.side-content-width; layout-height: root.content-height - 32px;
            preview: root.preview;
            opacity: 1 - root.content-opacity; enabled: false;
        }
    }
}
