export component InputIndicatorWindow inherits Window {
    title: "Echo Input Indicator";
    min-width: 48px; max-width: 48px; min-height: 36px; max-height: 36px;
    no-frame: true; always-on-top: true; background: transparent;
    in property <string> mode;
    in property <color> fill;
    in property <color> ink;
    in property <bool> contrast;
    in property <bool> reveal;
    in property <bool> animations: true;
    Rectangle {
        border-radius: 8px;
        background: root.fill;
        border-width: root.contrast ? 1px : 0px; border-color: root.ink;
        opacity: root.reveal ? 1 : 0;
        animate opacity { duration: root.animations && root.reveal ? 100ms : 0ms; easing: ease-out; }
        Text { text: root.mode; color: root.ink; font-size: 18px;
            horizontal-alignment: center; vertical-alignment: center; }
    }
}
