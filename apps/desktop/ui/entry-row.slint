import { EchoTheme, EchoButton } from "theme.slint";
import { DesignTokens as T } from "echo-tokens.slint";
import { FavoriteIconImages } from "favorite-icon-images.slint";
export struct EntryRow {
    key: string, title: string, body: string, kind: string,
    title-rich: styled-text, body-rich: styled-text, tags-rich: styled-text, source-rich: styled-text, match-count: int,
    source-label: string, time-label: string, section-label: string,
    thumbnail: image, has-thumbnail: bool, pinned: bool,
    selected: bool, batch-selected: bool, icon-key: string, tags: string,
}
struct RowAction { icon: image, label: string, command: string }
export component EntryView inherits Rectangle {
    in property <EntryRow> entry;
    in property <bool> favorites;
    in property <bool> compact;
    in property <bool> capture-only;
    in property <bool> thumbnail-active: true;
    in property <bool> batch;
    in property <bool> busy;
    in property <bool> input-blocked;
    in property <bool> inline-mode;
    in property <bool> quick-insert;
    in property <bool> copy-only;
    in property <bool> reorder-enabled;
    callback selected-geometry(length,length);
    // Virtualized row geometry changes during manual scrolling. Only a new
    // selection may request visibility; geometry changes must not pull it back.
    private property <bool> current-selection: entry.selected;
    changed current-selection => {
        if (root.current-selection && !root.capture-only) {root.selected-geometry(root.y,root.height);}
    }
    callback select(string);
    callback action(string,string);
    callback thumbnail-needed(string);
    function perform(action-name: string) {if (!root.busy && !root.input-blocked && !root.capture-only) {root.action(action-name,root.entry.key);}}
    callback key-event(string,bool,bool,string) -> bool;
    pure callback drag-data(string) -> data-transfer;
    callback can-drop-data(data-transfer) -> bool;
    callback drop-data(data-transfer,string) -> bool;
    private property <image> favorite-icon: FavoriteIconImages.image-for(entry.icon-key);
    private property <bool> active: entry.selected || entry.batch-selected;
    private property <int> focused-actions: 0;
    in property <bool> control-focus-mode;
    private property <bool> show-actions: !capture-only && (row-touch.has-hover || row-focus.has-focus || focused-actions > 0 || (entry.selected && control-focus-mode));
    private property <length> left-gutter: favorites && root.favorite-icon.width > 0 ? 48px : 20px;
    private property <length> action-width: favorites ? 3*T.row-action-size + 2*T.row-action-gap : 4*T.row-action-size + 3*T.row-action-gap;
    private property <length> action-right: favorites ? 12px : 36px;
    private property <length> content-width: max(0px,root.width - left-gutter - action-right - action-width - 8px);
    private property <[{icon: image, label: string, command: string}]> row-actions: favorites ? [
        {icon:@image-url("icons/apps-sdk/Copy.svg"),label:"Copy item",command:"copy"},
        {icon:@image-url("icons/apps-sdk/Pencil.svg"),label:"Edit saved content",command:"edit"},
        {icon:@image-url("icons/apps-sdk/Trash.svg"),label:"Delete everywhere…",command:"delete"},
    ] : [
        {icon:@image-url("icons/apps-sdk/Copy.svg"),label:"Copy item",command:"copy"},
        {icon:@image-url("icons/apps-sdk/Star.svg"),label:"Move to Favorites",command:"favorite"},
        {icon:entry.pinned ? @image-url("icons/apps-sdk/PinFilled.svg") : @image-url("icons/apps-sdk/Pin.svg"),label:entry.pinned ? "Unpin item" : "Pin item",command:"pin"},
        {icon:@image-url("icons/apps-sdk/Trash.svg"),label:"Delete this capture…",command:"delete"},
    ];
    height: max(compact ? T.row-compact-height : favorites ? T.row-saved-min-height : T.row-history-min-height, body-layout.min-height + 32px);
    min-width: 0px;
    background: transparent;
    Rectangle {
        x:2px;y:2px;width:parent.width - 4px;height:parent.height - 10px;
        background:drop.has-drag || (root.active && EchoTheme.high-contrast) ? EchoTheme.selection : EchoTheme.elevated;
        border-radius:T.row-radius;border-width:1px;
        border-color:EchoTheme.high-contrast ? EchoTheme.line : root.active ? EchoTheme.amber.with-alpha(0.5) : EchoTheme.line.with-alpha(0.75);
        drop-shadow-blur:root.active ? T.row-selected-shadow-softness : T.row-shadow-softness;
        drop-shadow-offset-y:root.active ? T.row-selected-shadow-offset-y : T.row-shadow-offset-y;
        drop-shadow-color:EchoTheme.high-contrast ? transparent : root.active ? T.row-selected-shadow-color : T.row-shadow-color;
    }
    accessible-role: list-item;
    accessible-enabled: !capture-only;
    accessible-label: entry.title == "" ? entry.body : entry.title + ": " + entry.body;
    accessible-item-selectable: !capture-only;
    accessible-item-selected: entry.selected;
    accessible-action-default => { if (!root.capture-only && !root.busy && !root.input-blocked) { root.select(entry.key); } }
    changed thumbnail-active => {if (thumbnail-active && entry.has-thumbnail && !capture-only) {root.thumbnail-needed(entry.key);}}
    init => { if (entry.has-thumbnail && !capture-only && thumbnail-active) { root.thumbnail-needed(entry.key); } }
    changed entry => {
        if (!capture-only) {
            if (entry.has-thumbnail && thumbnail-active) { root.thumbnail-needed(entry.key); }
        }
    }
    if (active): Rectangle { x: 8px; y: 12px; width: 3px; height: parent.height - 32px; background: EchoTheme.amber; border-radius: 1px; }
    if (!favorites): Rectangle { x: root.width - 24px; width: 1px; background: EchoTheme.line; }
    if (!favorites && !entry.pinned && !root.show-actions && !root.batch): Text {
        x: root.width - T.row-timeline-width - 12px; y: 18px; width: T.row-timeline-width - 24px; text: entry.time-label;
        color: root.active ? EchoTheme.selected-text : EchoTheme.muted; font-size: 12px; horizontal-alignment: right;
        accessible-role: none;
    }
    if (capture-only && !favorites && entry.pinned): Image {
        x: root.width - root.action-right - 2*T.row-action-size - T.row-action-gap + (T.row-action-size - T.row-action-icon-size)/2;
        y: 10px + (T.row-action-size - T.row-action-icon-size)/2;
        width: T.row-action-icon-size; height: T.row-action-icon-size;
        source: @image-url("icons/apps-sdk/PinFilled.svg");
        colorize: EchoTheme.high-contrast ? EchoTheme.text : T.row-action-color;
        accessible-role: none;
    }
    if (!favorites): Rectangle {
        x: root.width - 28px; y: 23px; width: 9px; height: 9px; border-radius: 5px;
        background: root.active || entry.pinned ? EchoTheme.amber : EchoTheme.muted;
    }
    if (favorites && root.favorite-icon.width > 0): Image {
        x: 9px; y: 15px; width: T.row-icon-size; height: T.row-icon-size;
        source: root.favorite-icon;
        colorize: root.active ? EchoTheme.selected-text : EchoTheme.muted;
    }
    // Let clicks reach the row; the drag ancestor takes over only after movement.
        drop := DropArea {
            width:root.width;height:root.height;
            enabled:root.favorites && root.reorder-enabled && !root.input-blocked && !root.busy;
            can-drop(event) => {return root.can-drop-data(event.data) ? DragAction.move : DragAction.none;}
            dropped(event) => {return root.drop-data(event.data,root.entry.key) ? DragAction.move : DragAction.none;}
            DragArea {
                width:root.width;height:root.height;
                enabled:root.favorites && root.reorder-enabled && !root.input-blocked && !root.busy;
                data:root.drag-data(root.entry.key);allow-move:true;
    row-touch := TouchArea {
        width:root.width;height:root.height;
        enabled:!root.busy && !root.capture-only;
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {root.perform("options");}
        }
        clicked => {
            if (!root.input-blocked) {
                if (!root.inline-mode) {row-focus.focus();}
                root.select(root.entry.key);
                if ((root.quick-insert || root.copy-only) && !root.batch) {root.perform(root.copy-only ? "copy" : "insert");}
            }
        }
    // Keep the buttons inside the row's input ancestry. Moving onto a button
    // must not remove the hover that makes that button visible.
    body-layout := VerticalLayout {
        x: root.left-gutter; width: root.content-width;
        height: self.min-height;
        y: 2px + max(0px,(root.height - 10px - self.height)/2);
        spacing: 4px; alignment: start;
        if (root.favorites): StyledText {
            default-font-family: "Microsoft YaHei UI";
            text: root.entry.title-rich; default-color: root.active ? EchoTheme.selected-text : EchoTheme.muted;
            default-font-size: T.font-secondary; min-width: 0px; max-height: 40px; accessible-role: none;
        }
        if (root.entry.has-thumbnail): Rectangle {
            height: T.row-image-height;
            background: EchoTheme.elevated;
            Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: root.entry.thumbnail; image-fit: contain; }
            if (root.entry.thumbnail.width == 0): Text { text: "Image"; color: EchoTheme.muted; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
        }
        if (root.entry.body != "" && !root.entry.has-thumbnail && root.entry.match-count == 0): Text {
            text: root.entry.body; color: root.active ? EchoTheme.selected-text : EchoTheme.text;
            font-family: "Microsoft YaHei UI"; font-size: T.font-body;
            wrap: word-wrap; overflow: elide; max-height: T.row-max-text-height; min-width: 0px; accessible-role: none;
        }
        if (root.entry.body != "" && !root.entry.has-thumbnail && root.entry.match-count > 0): StyledText {
            default-font-family: "Microsoft YaHei UI";
            text: root.entry.body-rich; default-color: root.active ? EchoTheme.selected-text : EchoTheme.text; default-font-size: T.font-body; max-height: T.row-max-text-height; min-width: 0px; accessible-role: none;
        }
        if (root.entry.tags != "" && !root.compact): StyledText {
            default-font-family: "Microsoft YaHei UI";
            text: root.entry.tags-rich; default-color: root.active ? EchoTheme.selected-text : EchoTheme.muted;
            default-font-size: T.font-caption; max-height: 24px; min-width: 0px; accessible-role: none;
        }
    }
    // Fixed geometry shares the time slot; no floating toolbar or content overlay.
    Rectangle {
        x: root.width - root.action-right - root.action-width; y: 10px;
        width: root.action-width; height: T.row-action-size;
        background: transparent;
        visible: !root.capture-only && (root.show-actions || root.batch || (!root.favorites && root.entry.pinned));
        HorizontalLayout {
            spacing: T.row-action-gap; alignment: end;
            if (root.batch): EchoButton {
                text: root.entry.batch-selected ? "✓ Selected" : "Select";
                label: "Toggle selection"; checked: root.entry.batch-selected;
                height: T.row-action-size;
                focus-changed(value) => {root.focused-actions = max(0,root.focused-actions + (value ? 1 : -1));}
                take-focus-on-click: !root.inline-mode; execution-blocked: root.input-blocked; enabled: !root.busy;
                clicked => {root.perform("toggle-batch");}
            }
            if (!root.batch): HorizontalLayout {
                spacing: T.row-action-gap; alignment: end;
                for item in root.row-actions: EchoButton {
                    width: T.row-action-size; row-action: true; flat: true;
                    visible: root.show-actions || (!root.favorites && root.entry.pinned && item.command == "pin");
                    icon: item.icon; label: item.label;
                    focus-changed(value) => {root.focused-actions = max(0,root.focused-actions + (value ? 1 : -1));}
                    take-focus-on-click: !root.inline-mode; execution-blocked: root.input-blocked; enabled: !root.busy;
                    clicked => {root.perform(item.command);}
                }
            }
        }
    }
    }
            }
        }
    row-focus := FocusScope {
        width: 0; enabled: !root.capture-only;
        key-pressed(event) => { return root.key-event(event.text,event.modifiers.control,event.modifiers.shift,"row") ? accept : reject; }
    }
}
