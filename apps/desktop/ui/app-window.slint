    out property <length> stage-height: root.height;
    in property <length> popup-card-width;
    in property <length> popup-card-height;
    in property <length> popup-card-top;
    in property <length> popup-card-left;
    in property <string> empty-state-text;
    out property <length> panel-width: max(120px,min(root.stage-width - 32px,root.popup-card-width > 0px ? root.popup-card-width : min(T.panel-max-width,max(T.panel-min-width,root.stage-width * T.panel-width-ratio))));
    out property <length> panel-height: root.inline-mode && root.popup-card-height > 0px ? root.popup-card-height : max(120px,root.stage-height - 2 * T.stage-padding-y);
    out property <length> panel-left: root.popup-card-width > 0px ? root.popup-card-left : (root.width - root.panel-width) / 2;
    out property <length> panel-top: root.inline-mode && root.popup-card-height > 0px ? root.popup-card-top : T.stage-padding-y;
    out property <length> settings-card-width: min(T.settings-card-max-width,root.width - 48px);
    out property <length> settings-card-left: (root.width - root.settings-card-width) / 2;
    private property <length> settings-scroll-anchor-x;
    private property <length> settings-scroll-anchor-y;
    out property <length> settings-scroll-x: root.settings-card-left + root.settings-scroll-anchor-x;
    out property <length> settings-scroll-y: 88px + root.settings-scroll-anchor-y;
    out property <bool> modal: editor-open || clear-confirm-open || space-dialog-open || picker-open || confirmation-open;
    callback ime-composing() -> bool;
    callback navigate-space(int);
    callback space-action(string,string);
    callback settings-edited();
    callback settings-action(string);
    callback picker-selected(string);
    callback picker-query-edited(string);
    callback picker-next();
    callback confirm(string);
    callback viewport-changed();
    callback stage-clicked(float,float);
    callback stage-scrolled(float);
    public function focus-content() {live-panel.focus-content();}
    public function focus-controls() {if (root.route == "history") {live-panel.focus-controls();} else {settings-back.focus();}}
    public function reset-scroll() { root.scroll-y = 0px; }
    public function reveal-selection() { live-panel.reveal-selection(); }
    changed width => { root.viewport-changed(); }
    changed height => { root.viewport-changed(); }
    changed dark => { EchoTheme.dark = root.dark; Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    title: "Echo Recall";
    preferred-width: T.window-width; preferred-height: T.window-height;
    min-width: root.quick-insert ? 120px : 320px; min-height: root.quick-insert ? 120px : 300px;
    no-frame: true;
    background: transparent;
    default-font-family: "Segoe UI"; default-font-size: T.font-body;
    FocusScope {
        x: 0px; y: 0px; width: root.width; height: root.height;
        key-pressed(event) => { if (root.ime-composing()) { return reject; } return root.key-event(event.text,event.modifiers.control,event.modifiers.shift,"control") ? accept : reject; }
        Rectangle {
            x: 0px; y: 0px; width: root.width; height: root.height;
            visible: !root.capture-mode; background: transparent;
            Rectangle {
                y: 0px; width: root.stage-width; height: root.stage-height;
                visible: root.route == "history"; clip: true;
                Rectangle {
                    visible: (root.navigation-busy || root.flow-settling) && root.flow-enabled;
                    x: root.moving-shadow-x; y: root.moving-shadow-y;
                    width: root.moving-shadow-width; height: root.moving-shadow-height;
                    background: transparent; border-radius: T.panel-radius;
                    drop-shadow-blur: T.flow-shadow-softness;
                    drop-shadow-offset-y: T.flow-shadow-offset-y;
                    drop-shadow-color: #000000.with-alpha(T.flow-shadow-opacity * root.front-shadow-opacity);
                }
                Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: root.stage-image; visible: root.flow-enabled; image-fit: fill; }
                TouchArea {
                    enabled: !root.modal && !root.busy;
                    private property <length> start-x;
                    private property <length> start-y;
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { self.start-x = self.mouse-x; self.start-y = self.mouse-y; }
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                            if (abs(self.mouse-x - self.start-x) > 48px && abs(self.mouse-y - self.start-y) < 32px) { root.navigate-space(self.mouse-x < self.start-x ? 1 : -1); }
                            else { root.stage-clicked(self.mouse-x / 1px,self.mouse-y / 1px); }
                        }
                    }
                    scroll-event(event) => {
                        if (abs(event.delta-x) > abs(event.delta-y)) { root.stage-scrolled(event.delta-x / 1px); return accept; }
                        return reject;
                    }
                }
            }
            live-panel := SpacePanel {
                x: root.panel-left; y: root.panel-top; width: root.panel-width; height: root.panel-height;
                visible: root.route == "history";
                opacity: (root.navigation-busy || root.flow-settling) && root.flow-enabled ? 0 : 1;
                inline-mode: root.inline-mode;
                control-focus-mode:root.control-focus-mode;
                title: root.space-title; subtitle: root.space-subtitle; icon-key: root.space-icon; accent: root.space-accent;
                rows: root.rows; favorites: root.active-view != "history"; clearable: root.space-clearable; capture-only: false;
                loading: root.loading; stale: root.stale-rows; error: root.status-error;
                empty-state-text: root.empty-state-text;
                busy: root.busy || root.modal || root.navigation-busy;
                compact: root.density == "compact"; batch: root.batch-mode; selected-count: root.selected-count;
                selection-index: root.selection-index; query <=> root.query; quick-insert: root.quick-insert && root.paste-target-available;
                copy-only: root.quick-insert && !root.paste-target-available;
                has-more: root.has-more; has-previous: root.has-previous; scroll-y <=> root.scroll-y;
                modal: root.modal; animating: root.navigation-busy;
                navigation-label: root.navigation-label; status: root.status; status-error: root.status-error;
                navigation-hint: root.control-focus-mode ? "F6  Quick navigation" : root.switch-shortcut == "ctrl_tab" ? "Ctrl+Tab / Ctrl+Shift+Tab" : "Tab / Shift+Tab";
                previous-enabled: root.previous-enabled; next-enabled: root.next-enabled;
                query-edited(value) => {root.query-edited(value);}
                ime-composing => {return root.ime-composing();}
                navigate(delta) => {root.navigate-space(delta);}
                choose-space => {root.space-action("navigator","");}
                new-space => {root.space-action("new","");}
                settings => {root.route-selected("settings");}
                hide => {root.dismiss();}
                drag => {root.drag-requested();}
                select(key) => { root.row-selected(key); }
                action(action,key) => { root.row-action(action,key); }
                batch-action(action) => { root.batch-action(action); }
                thumbnail-needed(key) => { root.thumbnail-requested(key); }
                key-event(key,ctrl,shift,target) => { return root.key-event(key,ctrl,shift,target); }
                create-item => { root.create-favorite(); }
                more => { root.load-more(); }
                previous => { root.previous-page(); }
                menu => { root.space-action("menu",""); }
                add-existing => { root.space-action("add-existing",""); }
                viewport-changed => { root.viewport-changed(); }
                drag-data(key) => { return root.drag-data(key); }
                can-drop-data(data) => { return root.can-drop-data(data); }
                drop-data(data,key) => { return root.drop-data(data,key); }
            }
            Rectangle {
                visible: root.route != "history";
                x:root.settings-card-left;y:24px;width:root.settings-card-width;height:parent.height - 48px;
                background:EchoTheme.surface;border-radius:T.panel-radius;border-width:1px;border-color:EchoTheme.line;clip:true;
                settings-back := EchoButton {x:24px;y:16px;width:96px;text:"Back";icon:@image-url("icons/back.svg");flat:true;
                    enabled:!root.modal;clicked => {root.route-selected("history");}}
            if (root.route == "settings"): SettingsPage {
                y: 64px; height: parent.height - 64px;
                scroll-anchor-changed(x,y) => {
                    root.settings-scroll-anchor-x = x;
                    root.settings-scroll-anchor-y = y;
                }
                history-enabled <=> root.history-enabled;
                record-sensitive <=> root.record-sensitive;
                store-window-titles <=> root.store-window-titles;
                max-entries-text <=> root.max-entries-text;
                max-total-mib-text <=> root.max-total-mib-text;
                max-item-mib-text <=> root.max-item-mib-text;
                theme-mode <=> root.theme-mode;
                view-mode <=> root.view-mode;
                motion <=> root.motion;
                motion-speed <=> root.motion-speed;
                switch-shortcut <=> root.switch-shortcut;
                global-hotkey-enabled <=> root.global-hotkey-enabled;
                global-hotkey <=> root.global-hotkey;
                caret-anchor <=> root.caret-anchor;
                inline-completion <=> root.inline-completion;
                hotkey-status: root.hotkey-status;
                startup-space <=> root.startup-space;
                query-on-switch <=> root.query-on-switch;
                density <=> root.density;
                side-content <=> root.side-content;
                graphics-mode <=> root.graphics-mode;
                frame-rate <=> root.frame-rate;
                loop-spaces <=> root.loop-spaces;
                remember-position <=> root.remember-position;
                reflections <=> root.reflections;
                trim-when-hidden <=> root.trim-when-hidden;
                reduce-on-battery <=> root.reduce-on-battery;
                spaces: root.spaces; busy: root.busy || root.modal; dirty: root.settings-dirty; valid: root.settings-valid; notice: root.settings-notice;
                restart-required: root.restart-required; error: root.settings-error; actual-mode: root.actual-mode;
                diagnostics: root.diagnostics; cache-status: root.cache-status; preview-image: root.preview-image;
                edited => { root.settings-edited(); }
                save => { root.save-settings(); }
                cancel => { root.settings-action("cancel"); }
                action(action) => { root.settings-action(action); }
                space-action(action,key) => { root.space-action(action,key); }
            }
            if (root.route == "about"): VerticalLayout {
                x: 32px; y: 110px; width: parent.width - 64px; height: parent.height - 180px;
                alignment: start; spacing: 24px;
                HorizontalLayout {
                    alignment: start; spacing: 16px; height: 48px;
                    Image { source: @image-url("../icons/echo-256.png"); width: 48px; height: 48px; image-fit: contain; }
                    Text { text: "Echo"; color: EchoTheme.text; font-size: 32px; font-weight: 600; vertical-alignment: center; }
                }
                Text { text: "Personal spaces for quick insertion\nRust + Slint · Windows · Version 0.1.0"; color: EchoTheme.muted; wrap: word-wrap; }
                AboutSlint { height: 120px; }
                Text { text: "Third-party notices are included in the application directory.\nClipboard data stays on this device."; color: EchoTheme.muted; wrap: word-wrap; min-width: 0px; }
                EchoButton { text: "Back to settings"; clicked => { root.route-selected("settings"); } }
            }
        }
        }
        if (root.capture-mode): SpacePanel {
            x: root.panel-left; y: root.panel-top; width: root.panel-width; height: root.panel-height;
            inline-mode: root.inline-mode;
            title: root.capture-title; subtitle: root.capture-subtitle; icon-key: root.capture-icon; accent: root.capture-accent;
            rows: root.capture-rows; favorites: root.capture-favorites; capture-only: true;
            titles-only: root.capture-titles-only; loading: root.capture-loading;
            compact: root.density == "compact"; scroll-y <=> root.capture-scroll;
        }
    if (root.editor-open && !root.capture-mode): Rectangle {
        background: #00000080;
        TouchArea { }
        FocusScope {
            key-pressed(event) => { if (root.ime-composing()) { return reject; }
                if (event.text == Key.Escape) { return root.key-event(event.text,event.modifiers.control,event.modifiers.shift,"control") ? accept : reject; }
                if (event.text == Key.Tab) {
                    if (event.modifiers.shift) {
                        if (name-edit.has-focus) { cancel-button.focus(); } else if (content-edit.has-focus) { name-edit.focus(); }
                        else if (icon-edit.has-focus) { content-edit.focus(); }
                        else if (choose-icon.focused) { icon-edit.focus(); } else if (save-button.focused) { choose-icon.focus(); } else { save-button.focus(); }
                    } else {
                        if (name-edit.has-focus) { content-edit.focus(); } else if (content-edit.has-focus) { icon-edit.focus(); }
                        else if (icon-edit.has-focus) { choose-icon.focus(); } else if (choose-icon.focused) { save-button.focus(); }
                        else if (save-button.focused) { cancel-button.focus(); } else { name-edit.focus(); }
                    } return accept;
                } return reject;
            }
            Rectangle {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: min(520px,parent.width - 32px); height: min(620px,parent.height - 40px);
                background: EchoTheme.elevated; border-radius: 15px; border-width: 1px; border-color: EchoTheme.line;
                accessible-role: groupbox; accessible-label: root.editor-new ? "Create favorite" : "Edit favorite";
                init => { name-edit.focus(); }
                VerticalLayout {
                    padding: 20px; spacing: 10px;
                    Text { text: root.editor-new ? "New content" : "Edit content"; color: EchoTheme.text; font-size: 21px; font-weight: 650; }
                    ScrollView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            spacing: 10px;
                    if (root.editor-sharing != ""): Text { text: root.editor-sharing; color: EchoTheme.muted; wrap: word-wrap; min-width: 0px; font-size: 12px; }
                    Text { text: "Name (required)"; color: EchoTheme.muted; font-size: 12px; }
                    name-edit := LineEdit {
                        text <=> root.draft-name; accessible-label: "Favorite name (required)"; enabled: !root.busy;
                        private property <int> focus-request: root.editor-name-focus-request;
                        changed focus-request => { self.focus(); }
                    }
                    Text { text: root.content-editable ? "Content" : "Original non-text content is preserved"; color: EchoTheme.muted; font-size: 12px; wrap: word-wrap; }
                    content-edit := TextEdit { accessible-action-set-value(value) => { if (root.content-editable && !root.busy) { root.draft-content = value; } } text <=> root.draft-content; read-only: !root.content-editable; accessible-label: "Favorite content"; enabled: !root.busy; min-height: 80px; }
                    Text { text: "Favorite icon"; color: EchoTheme.muted; font-size: 12px; }
                    HorizontalLayout {
                        spacing: 8px;
                        if (FavoriteIconImages.image-for(root.draft-icon).width > 0): Image {
                            width: 24px; height: 24px; source: FavoriteIconImages.image-for(root.draft-icon); colorize: EchoTheme.text;
                        }
                        icon-edit := LineEdit { text <=> root.draft-icon; accessible-label: "Favorite icon"; enabled: !root.busy; min-width: 0px; }
                        choose-icon := EchoButton {
                            text: "Choose icon"; enabled: !root.busy;
                            clicked => { root.picking-space-icon = false; root.filter-favorite-icons(""); root.icon-picker-open = true; }
                        }
                    }
                    if (root.status-error): Text { text: root.status; color: EchoTheme.danger; wrap: word-wrap; font-size: 12px; min-width: 0px; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px; alignment: end;
                        cancel-button := EchoButton { text: "Cancel"; enabled: !root.busy; clicked => { root.cancel-editor(); } }
                        save-button := EchoButton { text: root.busy ? "Saving…" : "Save favorite"; primary: true; enabled: !root.busy; clicked => { root.save-favorite(); } }
                    }
                }
            }
        }
    }
    if (root.clear-confirm-open && !root.capture-mode): Rectangle {
        background: #00000080;
        TouchArea { }
        FocusScope {
            key-pressed(event) => { if (root.ime-composing()) { return reject; }
                if (event.text == Key.Escape) { return root.key-event(event.text,event.modifiers.control,event.modifiers.shift,"control") ? accept : reject; }
                if (event.text == Key.Tab) { if (keep-button.focused) { clear-button.focus(); } else { keep-button.focus(); } return accept; }
                return reject;
            }
            Rectangle {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: min(440px,parent.width - 32px); height: 235px;
                background: EchoTheme.elevated; border-radius: 15px; border-width: 1px; border-color: EchoTheme.line;
                accessible-role: groupbox; accessible-label: "Clear clipboard history";
                init => { keep-button.focus(); }
                VerticalLayout {
                    padding: 24px; spacing: 16px;
                    Text { text: "Clear clipboard history?"; color: EchoTheme.text; font-size: 22px; font-weight: 650; }
                    Text { text: "This removes unpinned history.\nPinned items and Favorites are kept.\nThis cannot be undone."; color: EchoTheme.muted; wrap: word-wrap; }
                    HorizontalLayout {
                        alignment: end; spacing: 10px;
                        keep-button := EchoButton { text: "Keep history"; enabled: !root.busy; clicked => { root.clear-confirm-open = false; root.focus-content(); } }
                        clear-button := EchoButton { text: "Clear unpinned"; danger: true; enabled: !root.busy; clicked => { root.confirm-clear(); } }
                    }
                }
            }
        }
    }
        if (root.space-dialog-open && !root.capture-mode): Rectangle {
            background: #00000080; TouchArea { }
            FocusScope {
                key-pressed(event) => { if (root.ime-composing()) { return reject; } return event.text == Key.Escape && root.key-event(event.text,event.modifiers.control,event.modifiers.shift,"control") ? accept : reject; }
                Rectangle {
                    x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                    width: min(T.dialog-width,parent.width - 32px); height: min(480px,parent.height - 32px);
                    background: EchoTheme.elevated; border-radius: T.dialog-radius; border-width: 1px; border-color: EchoTheme.line;
                    accessible-role: groupbox; accessible-label: root.space-dialog-new ? "Create space" : "Edit space";
                    init => { space-name-input.focus(); }
                    VerticalLayout {
                        padding: 24px; spacing: 12px; alignment: start;
                        Text { text: root.space-dialog-new ? "New space" : "Edit space"; color: EchoTheme.text; font-size: 23px; font-weight: 600; }
                        Text { text: "Name · 1–32 characters"; color: EchoTheme.muted; }
                        space-name-input := LineEdit { text <=> root.space-draft-title; accessible-label: "Space name"; enabled: !root.busy; }
                        Text { text: "Description · optional"; color: EchoTheme.muted; }
                        LineEdit { text <=> root.space-draft-description; accessible-label: "Space description"; enabled: !root.busy; }
                        HorizontalLayout {
                            spacing: 10px;
                            LineEdit { text <=> root.space-draft-icon; accessible-label: "Space icon"; enabled: !root.busy; }
                            EchoButton { text: "Choose icon"; enabled: !root.busy; clicked => { root.picking-space-icon = true; root.filter-favorite-icons(""); root.icon-picker-open = true; } }
                        }
                        Text { text: "Accent · a small marker, not a full-card fill"; color: EchoTheme.muted; wrap: word-wrap; min-width: 0px; }
                        EnumChoice { model: ["amber","blue","green","violet","rose","slate"]; selected-index: root.space-draft-accent == "blue" ? 1 : root.space-draft-accent == "green" ? 2 : root.space-draft-accent == "violet" ? 3 : root.space-draft-accent == "rose" ? 4 : root.space-draft-accent == "slate" ? 5 : 0; selected(value) => { root.space-draft-accent = value; } accessible-label: "Space accent"; enabled: !root.busy; }
                        if (root.status-error): Text { text: root.status; color: EchoTheme.danger; wrap: word-wrap; min-width: 0px; }
                        HorizontalLayout {
                            alignment: end; spacing: 10px;
                            EchoButton { text: "Cancel"; enabled: !root.busy; clicked => { root.space-action("cancel",""); } }
                            EchoButton { text: root.busy ? "Saving…" : "Save space"; primary: true; enabled: !root.busy; clicked => { root.space-action("save",""); } }
                        }
                    }
                }
            }
        }
        if (root.picker-open && !root.capture-mode): Rectangle {
            background: #00000080; TouchArea { }
            FocusScope {
                key-pressed(event) => { if (root.ime-composing()) { return reject; } return event.text == Key.Escape && root.key-event(event.text,event.modifiers.control,event.modifiers.shift,"control") ? accept : reject; }
                Rectangle {
                    x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                    width: min(520px,parent.width - 32px); height: min(570px,parent.height - 40px);
                    background: EchoTheme.elevated; border-radius: T.dialog-radius; border-width: 1px; border-color: EchoTheme.line;
                    accessible-role: groupbox; accessible-label: root.picker-title;
                    Text { x: 24px; y: 20px; width: parent.width - 48px; text: root.picker-title; color: EchoTheme.text; font-size: 22px; font-weight: 600; overflow: elide; }
                    if (root.picker-searchable): LineEdit {
                        x: 24px; y: 58px; width: parent.width - 48px; text <=> root.picker-query;
                        accessible-label: "Search saved content"; enabled: !root.busy;
                        init => { self.focus(); }
                        edited => { root.picker-query-edited(self.text); }
                    }
                    ScrollView {
                        x: 20px; y: root.picker-searchable ? 108px : 62px; width: parent.width - 40px;
                        height: max(50px,parent.height - self.y - 96px);
                        VerticalLayout {
                            spacing: 8px; alignment: start;
                            if (root.picker-loading): Text { text: "Loading…"; color: EchoTheme.muted; }
                            for action in root.picker-actions: EchoButton {
                                text: action.label; label: action.label + (action.detail == "" ? "" : " · " + action.detail);
                                danger: action.danger; enabled: action.enabled && !root.busy && !root.picker-loading;
                                height: 40px; min-width: 0px; horizontal-stretch: 1; flat: true;
                                clicked => { root.picker-selected(action.key); }
                            }
                        }
                    }
                    if (root.status-error): Text { x: 24px; y: parent.height - 94px; width: parent.width - 48px; height: 34px; text: root.status; color: EchoTheme.danger; wrap: word-wrap; font-size: 12px; }
                    HorizontalLayout {
                        x: 24px; y: parent.height - 54px; width: parent.width - 48px; height: 36px; alignment: end; spacing: 10px;
                        if (root.picker-more): EchoButton { text: "Next page"; enabled: !root.busy && !root.picker-loading; clicked => { root.picker-next(); } }
                        EchoButton { text: "Close"; enabled: !root.busy; clicked => { root.picker-selected("cancel"); } }
                    }
                }
            }
        }
    if (root.icon-picker-open && (root.editor-open || root.space-dialog-open) && !root.capture-mode): FavoriteIconPicker {
        choices: root.favorite-icon-choices;
        selected-key: root.picking-space-icon ? root.space-draft-icon : root.draft-icon;
        filter(query) => { root.filter-favorite-icons(query); }
        chosen(key) => { if (root.picking-space-icon) { root.space-draft-icon = key; } else { root.draft-icon = key; } root.icon-picker-open = false; }
        dismissed => { root.icon-picker-open = false; }
    }
        if (root.confirmation-open && !root.capture-mode): Rectangle {
            background: #00000090; TouchArea { }
            FocusScope {
                key-pressed(event) => { if (root.ime-composing()) { return reject; }
                    if (event.text == Key.Escape) { root.confirm("cancel"); return accept; }
                    if (event.text == Key.Tab) { if (confirm-cancel.focused) { confirm-accept.focus(); } else { confirm-cancel.focus(); } return accept; }
                    return reject;
                }
                Rectangle {
                    x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                    width: min(T.dialog-width,parent.width - 32px); height: min(290px,parent.height - 32px);
                    background: EchoTheme.elevated; border-radius: T.dialog-radius; border-width: 1px; border-color: EchoTheme.line;
                    accessible-role: groupbox; accessible-label: root.confirmation-title;
                    init => { confirm-cancel.focus(); }
                    VerticalLayout {
                        padding: 24px; spacing: 16px;
                        Text { text: root.confirmation-title; color: EchoTheme.text; font-size: 22px; font-weight: 600; wrap: word-wrap; min-width: 0px; }
                        Text { text: root.confirmation-body; color: EchoTheme.muted; wrap: word-wrap; min-width: 0px; }
                        HorizontalLayout {
                            alignment: end; spacing: 10px;
                            confirm-cancel := EchoButton { text: "Cancel"; enabled: !root.busy; clicked => { root.confirm("cancel"); } }
                            confirm-accept := EchoButton { text: root.confirmation-button; danger: root.confirmation-danger; enabled: !root.busy; clicked => { root.confirm("accept"); } }
                        }
                    }
                }
            }
        }
    }
}

// Offscreen-only component. The injected adapter never creates a native window.
export component CardSnapshot inherits Window {
    in property <string> navigation-hint;
    in property <bool> previous-enabled;
    in property <bool> next-enabled;
    in property <bool> has-more;
    in property <bool> has-previous;
    in property <bool> batch;
    in property <int> selected-count;
    in property <bool> quick-insert;
    in property <bool> inline-mode;
    in property <string> panel-title;
    in property <string> subtitle;
    in property <string> icon-key;
    in property <color> accent;
    in property <[EntryRow]> rows;
    in property <bool> favorites;
    in property <bool> loading;
    in property <bool> titles-only;
    in property <bool> compact;
    in property <bool> dark;
    in-out property <string> query;
    in property <string> navigation-label;
    in-out property <length> scroll-y;
    changed dark => {EchoTheme.dark = root.dark; Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;}
    background:transparent;default-font-family:"Segoe UI";default-font-size:T.font-body;
    SpacePanel {
        x: 0px; y: 0px; width: root.width; height: root.height;
        inline-mode:root.inline-mode;
        title:root.panel-title;subtitle:root.subtitle;icon-key:root.icon-key;accent:root.accent;
        rows:root.rows;favorites:root.favorites;loading:root.loading;titles-only:root.titles-only;
        compact:root.compact;capture-only:true;query <=> root.query;
        navigation-hint:root.navigation-hint;
        previous-enabled:root.previous-enabled;next-enabled:root.next-enabled;
        has-more:root.has-more;has-previous:root.has-previous;
        batch:root.batch;selected-count:root.selected-count;quick-insert:root.quick-insert;
        scroll-y <=> root.scroll-y;navigation-label:root.navigation-label;
    }
}
