import { EchoSelect } from "echo-select.slint";
import { SpaceVm } from "space-models.slint";
import { FavoriteIconImages } from "favorite-icon-images.slint";

export component SpaceChoice inherits EchoSelect {
    in property <[SpaceVm]> spaces;
    has-icons: true;
    callback selected(int);
    selection-changed(index) => { root.selected(index); }
    icon-at(index) => {
        if (index < 0 || index >= root.spaces.length) { return @image-url("favorite-icons/Clock.svg"); }
        return root.spaces[index].icon-key == "" ? @image-url("favorite-icons/Folder.svg") : FavoriteIconImages.image-for(root.spaces[index].icon-key);
    }
}
