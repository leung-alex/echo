import { ScrollView } from "std-widgets.slint";
import { EchoTheme } from "theme.slint";
import { SpaceVm } from "space-models.slint";
import { FavoriteIconImages } from "favorite-icon-images.slint";

export component SpaceChoice inherits Rectangle {
    in property <[string]> model;
    in property <[SpaceVm]> spaces;
    in property <int> selected-index;
    in property <bool> enabled: true;
    private property <int> highlighted;
    private property <bool> popup-focused;
    private property <length> popup-scroll-y;
    callback selected(int);
    pure function icon-at(index: int) -> image {
        if (index >= root.spaces.length) { return @image-url("favorite-icons/Clock.svg"); }
        return root.spaces[index].icon-key == "" ? @image-url("favorite-icons/Folder.svg") : FavoriteIconImages.image-for(root.spaces[index].icon-key);
    }
    function open-menu() {
        if (!root.enabled || root.model.length == 0) { return; }
        root.highlighted = root.selected-index;
        root.popup-scroll-y = -max(0, root.highlighted - 5) * 40px;
        menu.show();
    }
    function choose(index: int) {
        if (root.enabled && index >= 0 && index < root.model.length) { root.selected(index); }
    }
    // Closing destroys the popup's repeated rows. Finish on this persistent
    // component so no row callback traverses a destroyed parent to restore focus.
    function dismiss-menu() {
        menu.close();
        focus.focus();
    }
    function commit-menu(index: int) {
        root.dismiss-menu();
        root.choose(index);
    }
    height: 36px; min-width: 160px;
    border-radius: 4px; border-width: 1px;
    border-color: focus.has-focus ? EchoTheme.amber : EchoTheme.line;
    background: EchoTheme.elevated; opacity: root.enabled ? 1 : 0.45;
    forward-focus: focus;
    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.popup-focused;
    accessible-value: root.model[root.selected-index];
    accessible-action-expand => { root.open-menu(); }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 10px;
        Image { source: root.icon-at(root.selected-index); colorize: EchoTheme.text; width: 18px; image-fit: contain; accessible-role: none; }
        Text { text: root.model[root.selected-index]; color: EchoTheme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; min-width: 0px; accessible-role: none; }
        Image { source: @image-url("icons/down.svg"); colorize: EchoTheme.muted; width: 12px; image-fit: contain; accessible-role: none; }
    }
    TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.open-menu(); } }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.open-menu(); return accept; }
            if (event.text == Key.DownArrow) { root.choose(min(root.model.length - 1, root.selected-index + 1)); return accept; }
            if (event.text == Key.UpArrow) { root.choose(max(0, root.selected-index - 1)); return accept; }
            return reject;
        }
    }
    menu := PopupWindow {
        // Keep every row above the field's bottom edge, inside the Settings
        // card's native input region even when the window has transparent margins.
        x: 0px; y: root.height - self.height; width: root.width;
        height: min(6, root.model.length) * 40px + 8px;
        close-policy: close-on-click-outside;
        forward-focus: menu-focus;
        Rectangle { background: EchoTheme.elevated; border-radius: 8px; border-width: 1px; border-color: EchoTheme.line; }
        menu-focus := FocusScope {
            focus-changed-event => { root.popup-focused = self.has-focus; }
            key-pressed(event) => {
                if (event.text == Key.Escape || event.text == Key.Tab) { root.dismiss-menu(); return event.text == Key.Tab ? reject : accept; }
                if (event.text == Key.Return || event.text == " ") { root.commit-menu(root.highlighted); return accept; }
                if (event.text == Key.DownArrow || event.text == Key.UpArrow || event.text == Key.Home || event.text == Key.End) {
                    root.highlighted = event.text == Key.Home ? 0 : event.text == Key.End ? root.model.length - 1 : clamp(root.highlighted + (event.text == Key.DownArrow ? 1 : -1), 0, root.model.length - 1);
                    if (root.highlighted * 40px < -menu-scroll.viewport-y) { menu-scroll.viewport-y = -root.highlighted * 40px; }
                    if ((root.highlighted + 1) * 40px > -menu-scroll.viewport-y + 240px) { menu-scroll.viewport-y = -(root.highlighted - 5) * 40px; }
                    return accept;
                }
                return reject;
            }
            menu-scroll := ScrollView {
                vertical-scrollbar-policy: always-off;
                horizontal-scrollbar-policy: always-off;
                viewport-y <=> root.popup-scroll-y;
                VerticalLayout {
                    padding: 4px; spacing: 0px; alignment: start;
                    for label[index] in root.model: Rectangle {
                        height: 40px; border-radius: 4px;
                        background: index == root.highlighted || touch.has-hover ? EchoTheme.selection : transparent;
                        accessible-role: list-item; accessible-label: label;
                        accessible-item-selected: index == root.selected-index;
                        accessible-action-default => { root.commit-menu(index); }
                        if (index == root.selected-index): Rectangle { x: 3px; y: 10px; width: 3px; height: 20px; border-radius: 2px; background: EchoTheme.amber; }
                        HorizontalLayout {
                            padding-left: 16px; padding-right: 12px; spacing: 10px;
                            Image { source: root.icon-at(index); colorize: EchoTheme.text; width: 18px; image-fit: contain; accessible-role: none; }
                            Text { text: label; color: EchoTheme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; min-width: 0px; accessible-role: none; }
                        }
                        touch := TouchArea { clicked => { root.commit-menu(index); } }
                    }
                }
            }
        }
    }
}
